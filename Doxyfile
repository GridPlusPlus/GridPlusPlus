PROJECT_NAME           = "Grid++"
PROJECT_BRIEF          = "給 C++ 初學者使用的網格遊戲函式庫"
OUTPUT_DIRECTORY       = site
OUTPUT_LANGUAGE        = Chinese-Traditional

INPUT                  = GridPlusPlus.h \
                         GameEngine.h \
                         GridObject.h \
                         Overlay.h \
                         GridMaze.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO

EXCLUDE_SYMBOLS        = gridpp::GameEngineImpl \
                         gridpp::GridObjectImpl \
                         gridpp::OverlayImpl \
                         gridpp::MazeImpl \
                         gridpp::GridValueStore \
                         gridpp::GridObjectType \
                         gridpp::OverlayType \
                         gridpp::GridObjectCallback \
                         gridpp::CollisionCallback \
                         gridpp::OverlayCallback \
                         gridpp::MazeCallback

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
INHERIT_DOCS           = YES
JAVADOC_AUTOBRIEF      = YES

GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES
